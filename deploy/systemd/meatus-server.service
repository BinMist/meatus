[Unit]
Description=Meatus relay (public server)
Documentation=https://gitee.com/binsail/meatus
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=meatus
Group=meatus
ExecStart=/usr/local/bin/meatus server --config /etc/meatus/server.toml
Restart=always
RestartSec=5s
TimeoutStopSec=30s
LimitNOFILE=1048576

# 面板 / HTTP 监听 80/443 时允许非 root 绑定特权端口
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# 最小文件系统权限；证书、ACME 缓存放 /var/lib/meatus
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
StateDirectory=meatus
StateDirectoryMode=0750
ReadWritePaths=/var/lib/meatus

[Install]
WantedBy=multi-user.target
